# ── Shell ──────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title
command = /bin/zsh
term = xterm-256color

# ── Font ───────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 12
font-thicken = true
adjust-cell-width = 0

# Ligatures
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss19
font-feature = ss20

# Palette inspirée du MOTD (cyan / green / yellow / magenta / red)
palette = 0=#1e1e2e
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#cba6f7
palette = 6=#89dceb
palette = 7=#cdd6f4
palette = 8=#45475a
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#cba6f7
palette = 14=#89dceb
palette = 15=#cdd6f4

background = #000000
foreground = #cdd6f4
cursor-color = #f5c2e7
selection-background = #45475a
selection-foreground = #cdd6f4

# ── Curseur ────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Fenêtre & rendu ────────────────────────
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
background-opacity = 0.95
background-blur-radius = 20
macos-titlebar-style = tabs
macos-option-as-alt = true
resize-overlay = never

# Performances
freetype-load-flags = no-hinting

# ── Splits natifs ──────────────────────────
# Nouveaux splits dans le même répertoire
window-inherit-working-directory = true
window-inherit-font-size = true

# ── Keybindings splits ─────────────────────
# Vertical   : Cmd+D
# Horizontal : Cmd+Shift+D
# Navigation : Cmd+Alt+Flèches
# Fermer     : Cmd+W
# Reset      : Cmd+R
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+enter=toggle_split_zoom

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

# Taille de police
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# ── Comportement ───────────────────────────
confirm-close-surface = false
quit-after-last-window-closed = true
copy-on-select = true
scrollback-limit = 10000
mouse-hide-while-typing = true

